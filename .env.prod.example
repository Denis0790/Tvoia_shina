# Скопировать в .env.prod НА СЕРВЕРЕ и заполнить (в git этот файл не попадает).
# Пароли и секрет — только из букв и цифр: openssl rand -hex 24  /  openssl rand -hex 32
DOMAIN=example.ru

POSTGRES_USER=tvoyashina
POSTGRES_PASSWORD=ЗАМЕНИТЬ
POSTGRES_DB=tvoyashina
# формат как в вашем текущем .env, но хост db и боевой пароль
DATABASE_URL=postgresql+asyncpg://tvoyashina:ЗАМЕНИТЬ@db:5432/tvoyashina
REDIS_URL=redis://redis:6379/0

JWT_SECRET=ЗАМЕНИТЬ_НА_64_СИМВОЛА
APP_ENV=production
COOKIE_SECURE=true
CORS_ORIGINS=https://example.ru
# true — код входа возвращается в ответе (ТОЛЬКО для закрытого теста), false — нужен SMS-провайдер
OTP_DEBUG=false

# --- Почта (Timeweb Mail): код регистрации приходит письмом ---
# Параметры SMTP смотрите в панели почты Timeweb (сервер, порт, SSL).
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=noreply@example.ru
SMTP_PASSWORD=ЗАМЕНИТЬ
SMTP_FROM=Твоя Шина <noreply@example.ru>
